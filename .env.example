# Public URL people open, without a trailing slash. Used for cookies, the cross-site check, links in emails and the Google redirect.
BASE_URL=http://localhost:3000
PORT=3000

# Database: a local file by default. For free hosting, use a free Turso database instead (turso.tech).
DATABASE_PATH=subtrack.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Email for reminders and password resets. Free with a Gmail app password (500 emails/day).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Subtrack <you@gmail.com>

# Protects the daily reminders endpoint. Use a long random string.
CRON_SECRET=

# Set to 1 when running behind a host's proxy (Render, Railway, Fly, nginx).
TRUST_PROXY=

# Optional: "Continue with Google" scan. Without it, people scan with an app password instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
