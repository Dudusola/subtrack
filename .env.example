# Public URL people open. Must match exactly (scheme + host), it is used for cookies, CSRF checks and the Google redirect.
BASE_URL=http://localhost:3000
PORT=3000
DATABASE_PATH=subtrack.db
# Optional: turns on "Scan inbox". Create at console.cloud.google.com > APIs & Services > Credentials (OAuth client, Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
